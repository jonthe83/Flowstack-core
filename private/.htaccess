# Hela private/ ska vara oläsbar på webben.
# Apache 2.4 läser Require. Apache 2.2 läser Order/Deny.
# RewriteEngine On utan [F] i den här filen slår ut rotens RewriteRule ^private/.
# Regeln nedan förbjuder allt när rewrite-motorn är på.
Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^ - [F,L]
</IfModule>
